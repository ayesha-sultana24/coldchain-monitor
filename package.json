{
  "name": "coldchain-monitor",
  "version": "1.0.0",
  "description": "IoT cold-chain monitoring for vaccines, blood and medicines, built on Redis (Streams, Sorted Sets, Hashes, Sets, HyperLogLog, Pub/Sub, Lua).",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "reseed": "node scripts/seed.js --reset",
    "test": "node --test tests/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0"
  }
}
